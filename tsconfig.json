{
  "compilerOptions": {
    "allowJs": false,
    "jsx": "react-native",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@assets/*": [
        "./assets/*"
      ],
      "@.storybook/*": [
        "./.storybook/*"
      ]
    }
  },
  "include": [
    "__tests__",
    "./src/**/*.ts",
    "./src/**/*.tsx",
    ".eslintrc.js",
    "*.js",
    "*.ts",
    "assets/svg/**/*",
    "index.js",
    "src",
  ],
  "exclude": [
    "node_modules",
    ".github"
  ],
  "extends": "@react-native/typescript-config/tsconfig.json"
}